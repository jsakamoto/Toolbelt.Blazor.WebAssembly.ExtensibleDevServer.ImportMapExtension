<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <Import Project="../VersionInfo.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required. Without this the SDK never generates an import map, and there is nothing for this
         package to compute a digest from. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Toolbelt.Blazor.WebAssembly.ExtensibleDevServer" Version="$(ExtensibleDevServerVersion)" PrivateAssets="all" />
    <PackageReference Include="Toolbelt.Blazor.WebAssembly.ExtensibleDevServer.ImportMapExtension" Version="$(ImportMapExtensionVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
